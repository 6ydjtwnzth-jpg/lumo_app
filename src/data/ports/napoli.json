    {
      "id": "plebiscito",
      "name": {
        "it": "Piazza del Plebiscito",
        "en": "Piazza del Plebiscito"
      },
      "category": "storia",
      "icon": "pantheon",
      "hidden": false,
      "coords": {
        "lat": 40.8359,
        "lng": 14.2486
      },
      "visitMinutes": 20,
      "summary": {
        "it": "La piazza più grande della città, tra Palazzo Reale e il colonnato di San Francesco di Paola.",
        "en": "The city's largest square, between the Royal Palace and the colonnade of San Francesco di Paola."
      },
      "curiosities": [
        {
          "it": "Il nome ricorda il plebiscito del 1860 che unì Napoli al Regno d'Italia.",
          "en": "The name recalls the 1860 plebiscite that joined Naples to the Kingdom of Italy."
        },
        {
          "it": "La basilica di San Francesco di Paola si ispira al Pantheon di Roma.",
          "en": "The basilica of San Francesco di Paola is inspired by Rome's Pantheon."
        },
        {
          "it": "Si dice che attraversare la piazza a occhi chiusi passando tra le due statue equestri sia quasi impossibile: prova.",
          "en": "They say walking blindfolded across the square between the two equestrian statues is almost impossible: give it a try."
        }
      ],
      "ticket": {
        "required": false
      },
      "verified": false
